#!/bin/sh
# Installs the fluxo binary sent on stdin and restarts the service:
#
#   fluxo-deploy SHA256 COMMIT < fluxo
#
# The deploy user's SSH key for fluxo can run only this, through sudo (see README.md).
# It stops fluxo and copies the database first,
# so if the new binary doesn't come up healthy, the old binary and the database (which the new
# binary's migrations may have changed) both go back.
set -eu
umask 077

BIN=/usr/local/bin/fluxo
DATA=/mnt/data/fluxo
HEALTH=http://127.0.0.1:8371/api/health
KEEP=5 # pre-deploy database copies kept in $DATA/backups

log() {
	echo "fluxo-deploy: $*"
	logger -t fluxo-deploy -- "$*" || true
}
fail() {
	log "$*"
	exit 1
}
healthy() {
	for _ in $(seq 30); do
		curl -fsS -o /dev/null --max-time 2 "$HEALTH" && return 0
		sleep 1
	done
	return 1
}
start() {
	systemctl reset-failed fluxo 2>/dev/null || true
	systemctl start fluxo
}

sha=${1:-}
commit=${2:-}
echo "$sha" | grep -Eqx '[0-9a-f]{64}' || fail "usage: fluxo-deploy SHA256 COMMIT < fluxo"
echo "$commit" | grep -Eqx '[0-9a-f]{40}' || fail "usage: fluxo-deploy SHA256 COMMIT < fluxo"

new=$(mktemp "$BIN.new.XXXXXX")
trap 'rm -f "$new"' EXIT
head -c 200000000 >"$new"
echo "$sha  $new" | sha256sum --check --status || fail "the binary's checksum doesn't match; nothing changed"
chmod 755 "$new"
# As fluxo, like the service: nothing uploaded ever runs as root.
runuser -u fluxo -- "$new" --version >/dev/null || fail "the new binary doesn't run here; nothing changed"

log "installing $commit"
systemctl stop fluxo
copy=
if [ -x "$BIN" ] && [ -f "$DATA/fluxo.db" ]; then
	copy=$DATA/backups/pre-deploy-$(date -u +%Y%m%d-%H%M%S)-$(echo "$commit" | cut -c1-12).db
	if ! runuser -u fluxo -- env FLUXO_CONFIG=/etc/fluxo/fluxo.toml "$BIN" backup "$copy" >/dev/null; then
		start
		fail "couldn't copy the database; nothing changed"
	fi
fi
[ -x "$BIN" ] && cp -p "$BIN" "$BIN.prev"
mv "$new" "$BIN"
start

if healthy; then
	ls -1t "$DATA"/backups/pre-deploy-*.db 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -f
	log "deployed $commit"
	exit 0
fi

# fluxo's own log stays on the server: this output ends up in public CI logs,
# and on a new instance fluxo's log holds the Administrator setup link.
log "$commit didn't come up healthy; going back (see journalctl -u fluxo)"
systemctl stop fluxo
if [ ! -x "$BIN.prev" ]; then
	fail "there's no previous version to go back to; fluxo is stopped"
fi
cp -p "$BIN.prev" "$BIN"
if [ -n "$copy" ]; then
	rm -f "$DATA/fluxo.db" "$DATA/fluxo.db-wal" "$DATA/fluxo.db-shm"
	install -m 600 -o fluxo -g fluxo "$copy" "$DATA/fluxo.db"
fi
start
healthy || fail "the previous version didn't come up either; see journalctl -u fluxo"
fail "went back to the previous version; see journalctl -u fluxo"
