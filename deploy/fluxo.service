# /etc/systemd/system/fluxo.service on fluxo.dev.
[Unit]
Description=fluxo critical-path planning
After=network.target
RequiresMountsFor=/mnt/data/fluxo

[Service]
User=fluxo
Group=fluxo
ExecStart=/usr/local/bin/fluxo serve
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/mnt/data/fluxo
# Further sandboxing (checked with `systemd-analyze security fluxo`); fluxo needs only files in
# its data directory and TCP on localhost.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
